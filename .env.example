# Конфигурация развёртывания в закрытом контуре (скопировать в .env).
# docker compose автоматически подхватывает переменные из .env.

# --- PostgreSQL (постоянное хранение) ---
POSTGRES_USER=wells
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=wells

# --- Безопасность ---
# Секрет подписи cookie. Сгенерировать: openssl rand -hex 32
WELLAPP_SECRET_KEY=change-me-in-production

# --- Приём телеметрии ChirpStack v3 ---
# Если задан — ChirpStack должен слать заголовок Authorization: Bearer <токен>
# при POST /api/uplink. Пусто = без проверки токена (закрытый контур).
WELLAPP_CHIRPSTACK_TOKEN=

# --- Пороги мониторинга ---
WELLAPP_OFFLINE_MINUTES=180
WELLAPP_RATE_DROP_PCT=30

# --- SMTP для рассылки отчётов (необязательно) ---
WELLAPP_SMTP_HOST=
WELLAPP_SMTP_PORT=587
WELLAPP_SMTP_USER=
WELLAPP_SMTP_PASSWORD=
WELLAPP_SMTP_FROM=monitoring@kbm.kz
